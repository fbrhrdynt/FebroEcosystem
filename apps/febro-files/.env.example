NODE_ENV=production
HOST=127.0.0.1
PORT=3480
APP_URL=https://files.febro.id
OIDC_ISSUER=https://auth.febro.id
OIDC_CLIENT_ID=febro-files
OIDC_CLIENT_SECRET=SET_BY_INSTALL_SCRIPT
SESSION_SECRET=SET_BY_INSTALL_SCRIPT
ADMIN_EMAILS=febroherdyanto@outlook.com
MAX_UPLOAD_MB=512
DATA_DIR=./data

# CMS owns document grants. Distinct read-only service credential; >=48 chars.
# Set the same FILES_CMS_SERVICE_TOKEN in CMS. Never share database credentials.
FILES_CMS_SERVICE_TOKEN=
FEBRO_CMS_API_URL=http://127.0.0.1:3090
# Existing CMS upload/metadata/private stream bridge; >=48 chars.
FEBRO_PROFILE_SERVICE_TOKEN=
