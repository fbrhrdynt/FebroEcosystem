function bindOwnItems(items){const itemsById=new Map(items.map(x=>[x.id,x]));$('#content').querySelectorAll('[data-open]').forEach(b=>b.onclick=()=>{const n=itemsById.get(b.dataset.open);if(n.kind==='folder'){folder=n.id;renderFiles();}else download('/api/items/'+n.id+'/download')});$('#content').querySelectorAll('[data-share]').forEach(b=>b.onclick=()=>shareDialog(itemsById.get(b.dataset.share)));$('#content').querySelectorAll('[data-more]').forEach(b=>b.onclick=()=>itemMenu(itemsById.get(b.dataset.more)));}
async function renderFiles(){const c=$('#content');c.innerHTML=`<div class="header"><div><div class="eyebrow">MY WORKSPACE / PRIVATE STORAGE</div><h1>My Files</h1><p>Atur dokumen dan project dalam satu tempat yang rapi.</p></div><div class="actions"><button class="pill" id="new-folder">＋ New Folder</button><button class="pill primary" id="upload">↑ Upload files</button></div></div><div class="panel"><div class="panel-head"><div class="crumbs" id="crumbs"></div><div class="mini">Private by default</div></div><div class="panel-inner"><label class="searchbox"><span>⌕</span><input id="file-search" type="search" placeholder="Cari file dan folder…" autocomplete="off"></label></div><div id="filelist"><div class="empty">Memuat file…</div></div></div>`;
 $('#upload').onclick=()=>$('#picker').click();$('#new-folder').onclick=()=>{dialog('Folder baru','<p>Tambahkan folder untuk menyusun file.</p><div class="form-row"><label>Nama folder</label><input id="folder-name" maxlength="180" placeholder="Misalnya: Project 2026"></div>','Buat folder',async w=>{await post('/api/folders',{name:w.querySelector('#folder-name').value,parent:folder});await renderFiles()});};
 $('#file-search').oninput=()=>{clearTimeout(searchTimer);const q=$('#file-search').value.trim();searchTimer=setTimeout(async()=>{if(q.length<2){loadList();return;}try{const {items}=await api('/api/search?q='+encodeURIComponent(q));renderItems(items,'Pencarian: '+q);}catch(e){toast(e.message)}},300);};
 async function loadList(){const {items,breadcrumbs}=await api('/api/list'+(folder?'?parent='+encodeURIComponent(folder):''));if(!document.contains(c))return;$('#crumbs').innerHTML='<button data-crumb="">My Files</button>'+breadcrumbs.map(x=>' <span style="color:var(--muted)">/</span> <button data-crumb="'+x.id+'">'+h(x.name)+'</button>').join('');$('#crumbs').querySelectorAll('[data-crumb]').forEach(b=>b.onclick=()=>{folder=b.dataset.crumb||null;renderFiles()});renderItems(items);}
