async function uploadFiles(files){if(!files.length)return;const quota=user.quotaBytes-user.usedBytes;
 let ok=0;for(const file of files){if(file.size>quota||file.size>512*1024*1024){toast('File '+file.name+' melebihi kuota atau batas upload');continue;}
  const box=dialog('Uploading file','<p>'+h(file.name)+'</p><div class="progress"><i id="pct"></i></div><p id="upload-status">Mengunggah…</p>','Tutup',async()=>{});box.querySelector('#confirm').disabled=true;
  try{await new Promise((resolve,reject)=>{const xhr=new XMLHttpRequest();xhr.open('POST','/api/upload?name='+encodeURIComponent(file.name)+'&parent='+(folder||''));xhr.setRequestHeader('Content-Type','application/octet-stream');xhr.upload.onprogress=e=>{if(e.lengthComputable){box.querySelector('#pct').style.width=(e.loaded/e.total*100).toFixed(1)+'%';box.querySelector('#upload-status').textContent=fmt(e.loaded)+' / '+fmt(e.total);}};xhr.onload=()=>{if(xhr.status===201)resolve();else{try{reject(Error(JSON.parse(xhr.responseText).error));}catch(e){reject(e);}}};xhr.onerror=()=>reject(Error('Koneksi upload gagal'));xhr.send(file)});ok++;}catch(e){toast(file.name+': '+e.message);}finally{box.remove();}
 }if(ok)toast(ok+' file berhasil diupload');await Promise.all([refreshUsage(),render()]);}
