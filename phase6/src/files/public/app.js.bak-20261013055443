async function renderAdmin(){const [stats,logs]=await Promise.all([api('/api/admin/users'),api('/api/admin/logs')]);let total=stats.users.reduce((s,u)=>s+u.used_bytes,0);$('#content').innerHTML=`<div class="header"><div><div class="eyebrow">SYSTEM MANAGEMENT / ADMIN ONLY</div><h1>Admin Console</h1><p>Kelola kuota dan pengguna. File pribadi tidak dapat dibuka oleh admin melalui dashboard ini.</p></div></div><div class="cards"><div class="stat"><label>Registered users</label><b>${stats.users.length}</b></div><div class="stat"><label>Storage used</label><b>${fmt(total)}</b></div><div class="stat"><label>Default user quota</label><b>${fmt(stats.defaultQuotaBytes)}</b></div></div><div class="panel"><div class="panel-head"><strong>Default storage quota</strong><button class="pill" id="change-default">Change default</button></div><div class="panel-inner note">Kuota awal saat ini ${fmt(stats.defaultQuotaBytes)}. Perubahan berlaku untuk akun yang tidak memiliki override kuota.</div></div><div class="panel"><div class="panel-head"><strong>User management</strong><small>Change individual quota or suspend Files access</small></div><div class="scroll"><table class="admin-table"><thead><tr><th>User</th><th>Used</th><th>Quota (MB)</th><th>Account</th><th>Action</th></tr></thead><tbody>${stats.users.map(a=>`<tr><td><strong>${h(a.name)}</strong><br><span class="mini">${h(a.email)}</span></td><td>${fmt(a.used_bytes)}</td><td><input aria-label="Quota MB" type="number" min="0" max="10240" value="${Math.round(a.quotaBytes/MB)}" data-quota="${a.sub}"></td><td>${a.blocked?'Suspended':'Active'}</td><td><button class="pill" data-save-quota="${a.sub}">Save</button> <button class="pill" data-block="${a.sub}" data-value="${a.blocked?'0':'1'}">${a.blocked?'Unblock':'Suspend'}</button></td></tr>`).join('')}</tbody></table></div></div><div class="panel"><div class="panel-head"><strong>Recent audit activity</strong></div><div class="scroll"><table class="admin-table"><thead><tr><th>Time</th><th>Action</th><th>Actor</th></tr></thead><tbody>${logs.logs.slice(0,50).map(l=>`<tr><td>${date(l.created_at)}</td><td>${h(l.action)}</td><td>${h(l.actor_sub)}</td></tr>`).join('')}</tbody></table></div></div>`;
 $('#change-default').onclick=()=>dialog('Default storage quota',`<p>Storage awal untuk akun yang tidak memiliki kuota khusus.</p><div class="form-row"><label>Kuota (MB)</label><input type="number" id="mb" min="1" max="10240" value="${Math.round(stats.defaultQuotaBytes/MB)}"></div>`,'Simpan',async w=>{await post('/api/admin/default-quota',{mb:Number(w.querySelector('#mb').value)});await renderAdmin();});
 $('#content').querySelectorAll('[data-save-quota]').forEach(b=>b.onclick=async()=>{const mb=Number($('[data-quota="'+b.dataset.saveQuota+'"]').value);try{await post('/api/admin/users/'+b.dataset.saveQuota+'/quota',{mb});toast('Quota tersimpan');await renderAdmin();}catch(e){toast(e.message)}});$('#content').querySelectorAll('[data-block]').forEach(b=>b.onclick=async()=>{if(!confirm(b.dataset.value==='1'?'Suspend user from Files?':'Unblock user?'))return;try{await post('/api/admin/users/'+b.dataset.block+'/blocked',{blocked:b.dataset.value==='1'});await renderAdmin();}catch(e){toast(e.message);}});}

async function render(){document.querySelectorAll('[data-nav]').forEach(n=>n.classList.toggle('active',n.dataset.nav===page));try{if(page==='files')await renderFiles();if(page==='trash')await renderTrash();if(page==='links')await renderLinks();if(page==='shared')await renderShared();if(page==='admin'&&user.isAdmin)await renderAdmin();await refreshUsage();}catch(e){$('#content').innerHTML='<div class="panel panel-inner">'+h(e.message)+'</div>';}}
async function initPublic(token){const r=async(f=null)=>{try{const result=await api('/api/public/'+token+(f?'?folder='+f:''));shareState.folder=f;root.innerHTML=`<div class="public-share"><div class="public-head"><a href="/" class="logo" style="padding:0"><span class="mark">F</span><span><strong>Febro Files</strong><span>by Febro Herdyanto</span></span></a><span class="mini">SECURE SHARE</span></div><div class="header"><div><div class="eyebrow">SHARED DOCUMENTS</div><h1>${h(result.item.name)}</h1><p>Link berbagi dengan akses baca dan download.</p></div></div><div class="panel"><div class="panel-head"><strong>${h(result.item.kind==='folder'?'Shared folder':'Shared file')}</strong><span class="mini">${result.maxDownloads?result.downloads+'/'+result.maxDownloads+' downloads':'Expires '+date(result.expiresAt)}</span></div>${result.item.kind==='file'?`<div class="panel-inner"><button class="pill primary" id="file-download">↓ Download ${h(result.item.name)}</button></div>`:result.children.map(n=>`<div class="file-row"><div class="file-title"><span class="file-icon">${icon(n)}</span><strong>${h(n.name)}</strong></div><span class="file-meta size">${n.kind==='file'?fmt(n.size):'Folder'}</span><span class="mini date">Read only</span><div class="row-buttons"><button data-node="${n.id}" data-kind="${n.kind}">${n.kind==='folder'?'Open':'Download'}</button></div></div>`).join('')||'<div class="empty">Folder kosong</div>'}</div>${f?'<button class="pill" id="public-back">← Shared root</button>':''}<div class="footer">A private share via Febro Files — by Febro Herdyanto</div></div>`;
 $('#file-download')?.addEventListener('click',()=>download('/api/public/'+token+'/download/'+result.item.id));$('#public-back')?.addEventListener('click',()=>r());document.querySelectorAll('[data-node]').forEach(b=>b.onclick=()=>b.dataset.kind==='folder'?r(b.dataset.node):download('/api/public/'+token+'/download/'+b.dataset.node));
 }catch(e){if(e.message==='PASSWORD_REQUIRED'){root.innerHTML=`<div class="login-main" style="min-height:100vh"><div class="login-box"><div class="mark">F</div><h2>Protected share</h2><p>Masukkan password untuk membuka file yang dibagikan.</p><form id="unlock"><div class="form-row"><label>Share password</label><input type="password" id="share-pwd" required></div><button class="pill primary" type="submit">Open shared files</button></form><p class="mini">Febro Files — by Febro Herdyanto</p></div></div>`;$('#unlock').onsubmit=async ev=>{ev.preventDefault();try{await post('/api/public/'+token+'/unlock',{password:$('#share-pwd').value});r(f);}catch(x){toast(x.message)}};return;}root.innerHTML='<div class="login-main" style="min-height:100vh"><div class="login-box"><h2>Share unavailable</h2><p>'+h(e.message)+'</p><a href="/">Back to Files</a></div></div>';}};await r();}
async function init(){if(localStorage.getItem('files-dark')==='1')document.documentElement.classList.add('dark');const pub=location.pathname.match(/^\/s\/([A-Za-z0-9_-]{40,120})$/);if(pub)return initPublic(pub[1]);try{const me=await api('/api/me');user=me.user;if(!user)return login();shell();render();}catch(e){root.innerHTML='<div class="login-main"><h2>'+h(e.message)+'</h2></div>';}}init();
