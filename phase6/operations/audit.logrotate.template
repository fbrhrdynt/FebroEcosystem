# Review only. Replace PROVIDER_PRIVATE_DIR with verified dedicated provider path.
# appendFileSync opens per write, so rename/create rotation needs no process reload.
PROVIDER_PRIVATE_DIR/audit.jsonl {
    daily
    maxsize 10M
    rotate 30
    missingok
    notifempty
    compress
    delaycompress
    create 0600 ubuntu ubuntu
    su ubuntu ubuntu
}
